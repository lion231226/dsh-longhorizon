# Test scratch space. The harness may run with a sandbox that denies the
# platform temp directory, so tests create their fixtures inside the repo.
.tmp/

# Local development links to the harness runtime packages. These are
# peerDependencies at install time and must never be committed or published.
node_modules/

# Acceptance-probe scratch: the staged tarball, fixtures and per-run state are
# rebuilt by `npm run verify`. The report and evidence ARE committed — a verdict
# nobody can inspect is worth nothing.
verify/pack/
verify/scratch-*/
verify/fixtures/

*.log
.DS_Store
Thumbs.db
